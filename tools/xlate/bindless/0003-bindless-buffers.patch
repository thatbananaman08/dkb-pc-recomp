+        // The push constant block { uint64 record; } at the stage offset, and the record struct { uint64 buffer[count]; uint slot[textures]; }
+        // read through PhysicalStorageBuffer64 (std430 strides 8 and 4).
+        private static void DeclareBindlessRecord(CodeGenContext context, int textures)
+        {
+            context.AddCapability(Capability.PhysicalStorageBufferAddresses);
+            context.AddCapability(Capability.Int64);
+            context.AddExtension("SPV_KHR_physical_storage_buffer");
+
+            if (textures > 0)
+            {
+                context.AddCapability(Capability.RuntimeDescriptorArray);
+                context.AddExtension("SPV_EXT_descriptor_indexing");
+            }
+
+            SpvInstruction u64 = context.TypeInt(64, 0);
+            int buffers = context.BindlessBufferCount;
+            List<SpvInstruction> members = new();
+            List<int> offsets = new();
+
+            // One scalar member per buffer address and per texture slot (no array types: their ArrayStride would clash with the buffer structs).
+            for (int i = 0; i < buffers; i++)
+            {
+                members.Add(u64);
+                offsets.Add(i * 8);
+            }
+
+            context.BindlessRecordTexMember = members.Count;
+
+            for (int i = 0; i < textures; i++)
+            {
+                members.Add(context.TypeU32());
+                offsets.Add(buffers * 8 + i * 4);
+            }
+
+            if (members.Count == 0)
+            {
+                return;
+            }
+
+            SpvInstruction record = context.TypeStruct(false, members.ToArray());
+            context.Decorate(record, Decoration.Block);
+
+            for (int i = 0; i < offsets.Count; i++)
+            {
+                context.MemberDecorate(record, i, Decoration.Offset, (LiteralInteger)offsets[i]);
+            }
+
+            context.BindlessRecordPointerType = context.TypePointer(StorageClass.PhysicalStorageBuffer, record);
+            context.BindlessRecordU64Pointer = context.TypePointer(StorageClass.PhysicalStorageBuffer, u64);
+            context.BindlessRecordU32Pointer = context.TypePointer(StorageClass.PhysicalStorageBuffer, context.TypeU32());
+
+            // The push constant block is two 32-bit words (low, high), not one 64-bit member: a struct of one uint64 would be the type of a record
+            // with a single buffer, which cannot be decorated twice.
+            SpvInstruction pushStruct = context.TypeStruct(false, context.TypeU32(), context.TypeU32());
+            context.Decorate(pushStruct, Decoration.Block);
+            context.MemberDecorate(pushStruct, 0, Decoration.Offset, (LiteralInteger)context.HostCapabilities.BindlessBufferRecord);
+            context.MemberDecorate(pushStruct, 1, Decoration.Offset, (LiteralInteger)(context.HostCapabilities.BindlessBufferRecord + 4));
+
+            SpvInstruction pushPointer = context.TypePointer(StorageClass.PushConstant, pushStruct);
+            SpvInstruction push = context.Variable(pushPointer, StorageClass.PushConstant);
+
+            context.Name(push, "bindless_record");
+            context.AddGlobalVariable(push);
+
+            context.BindlessPush = push;
+            context.BindlessPushU64Pointer = context.TypePointer(StorageClass.PushConstant, context.TypeU32());
+
+            foreach (KeyValuePair<int, SpvInstruction> pair in context.BindlessBufferTypes)
+            {
+                context.BindlessBufferPointerTypes[pair.Key] = context.TypePointer(StorageClass.PhysicalStorageBuffer, pair.Value);
+            }
+        }
